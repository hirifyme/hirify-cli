# Release mode of the Hirify CLI npm package. Only the owner changes HIRIFY_DEPLOY_MODE.
# The package is public on npm and people run it, so a release needs production approval.
HIRIFY_DEPLOY_MODE=production
HIRIFY_RELEASE_FLOW=pr

# The CLI has no web UI. Its user scenario is the packaged command line, checked by the
# `candidate` job: package install on Windows, macOS and Linux plus the Codex sandbox smoke.
HIRIFY_E2E_EXEMPT="npm CLI without web UI; the candidate job installs and runs the exact artifact on every platform"
